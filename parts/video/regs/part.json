    {"name": "video", "type": "video.rgb", "role": null,    "direction": "out",   "width": 24, "required": true,  "description": "Digital RGB video output"},
    {"name": "clk",   "type": "clock",     "role": null,    "direction": "in",    "width": 1,  "required": true,  "description": "Clock input"},
    {"name": "reset", "type": "reset",     "role": null,    "direction": "in",    "width": 1,  "required": true,  "description": "Reset input"},
    {"name": "irq",   "type": "irq",       "role": null,    "direction": "out",   "width": 1,  "required": false, "description": "GPU interrupt output"}
  ]
}
