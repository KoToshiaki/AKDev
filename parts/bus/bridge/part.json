{
  "id": "bus.bridge",
  "name": "Bus Bridge",
  "category": "bus",
  "description": "Inter-chip bus bridge for chip-to-chip communication",
  "schema_version": 2,
  "ports": [
    {"name": "master", "type": "bus.master", "role": "master", "direction": "inout", "width": 32, "required": true, "description": "Downstream bus (master)"},
    {"name": "slave",  "type": "bus.slave",  "role": "slave",  "direction": "inout", "width": 32, "required": true, "description": "Upstream bus (slave)"},
    {"name": "clk",    "type": "clock",      "role": null,     "direction": "in",    "width": 1,  "required": true, "description": "Clock input"},
    {"name": "reset",  "type": "reset",      "role": null,     "direction": "in",    "width": 1,  "required": true, "description": "Reset input"}
  ]
}
